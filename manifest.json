{
  "manifest_version": 3,
  "name": "Grammar & Style Checker",
  "version": "0.1.0",
  "description": "A lightweight grammar checker for Google Docs.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
